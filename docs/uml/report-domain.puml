
@startuml
title Brul2 - Report Domain Model

skinparam classAttributeIconSize 0
skinparam linetype ortho

abstract class Report {
    +id: Long
    +title: String
    +description: String
    +location: Location
    +status: ReportStatus = OPEN
    {abstract} +type: ReportType
    {abstract} +summary(): String
}

class SafetyReport {
    +urgent: Boolean
    +type: ReportType = SAFETY
    +summary(): String
}

class NuisanceReport {
    +category: String
    +type: ReportType = NUISANCE
    +summary(): String
}

class HelpRequest {
    +volunteersNeeded: Int
    +type: ReportType = HELP_REQUEST
    +summary(): String
}

class Location <<data class>> {
    +latitude: Double
    +longitude: Double
}

enum ReportStatus {
    OPEN
    IN_PROGRESS
    RESOLVED
}

enum ReportType {
    SAFETY
    NUISANCE
    HELP_REQUEST
}

Report <|-- SafetyReport
Report <|-- NuisanceReport
Report <|-- HelpRequest

Report --> "1" Location : location
Report --> "1" ReportStatus : status
Report --> "1" ReportType : type

@enduml
