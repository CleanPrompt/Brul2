' docs/uml/02-database-erd.puml

@startuml

title Brul2 - 02. Database ERD

' Visual style
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundCorner 0
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam defaultFontColor #243247
skinparam ArrowColor #243247
skinparam ArrowThickness 1
skinparam linetype ortho

skinparam entity {
    BackgroundColor #F3E8FF
    BorderColor #243247
    FontColor #243247
}

skinparam note {
    BackgroundColor #FFF7ED
    BorderColor #D97706
    FontColor #243247
}

hide circle
left to right direction

entity "users" as users {
    * id : BIGINT <<PK>>
    --
    * username : VARCHAR(50)
    * email : VARCHAR(254) <<UNIQUE>>
    * password_hash : VARCHAR(255)
    * created_at : BIGINT
    * role : VARCHAR(10)
}

entity "reports" as reports {
    * id : BIGINT <<PK>>
    --
    owner_id : BIGINT <<nullable>>
    * type : VARCHAR(30)
    * title : VARCHAR(120)
    * description : TEXT
    * latitude : DOUBLE
    * longitude : DOUBLE
    * status : VARCHAR(30)
    urgent : BOOLEAN <<nullable>>
    * category : VARCHAR(100)
    volunteers_needed : INTEGER <<nullable>>
    * created_at : BIGINT
    * view_count : INTEGER
}

entity "votes" as votes {
    * id : BIGINT <<PK>>
    --
    * report_id : BIGINT <<FK>>
    * user_id : BIGINT
    * type : VARCHAR(10)
}

entity "help_participations" as help_participations {
    * id : BIGINT <<PK>>
    --
    * help_request_id : BIGINT <<FK>>
    * user_id : BIGINT
}

' Database-enforced foreign keys
reports ||--o{ votes : "report_id / CASCADE"
reports ||--o{ help_participations : "help_request_id / CASCADE"

' Logical relationships without database foreign keys
users ||..o{ reports : "owner_id"
users ||..o{ votes : "user_id"
users ||..o{ help_participations : "user_id"

note bottom of votes
    UNIQUE (report_id, user_id)

    A user can have at most
    one vote per report.
end note

note bottom of help_participations
    UNIQUE (help_request_id, user_id)

    A user can join the same
    help request only once.
end note

legend bottom
    Solid line: database foreign key
    Dotted line: logical relationship only

    PK = Primary Key
    FK = Foreign Key
endlegend

@enduml